# ── Phase 15: Google Search Console Rank Monitor ──────────────────────────────
# Required for: node scripts/gsc-rank-monitor.mjs  (weekly rank tracking)
# Value: The FULL JSON content of your GSC service-account key file (not the path).
#
# Setup steps:
#   1. console.cloud.google.com → Enable "Google Search Console API"
#   2. IAM → Service Accounts → Create → name: nyutaelite-gsc-reader
#   3. Create JSON key → download file
#   4. GSC → Settings → Users & permissions → Add user (restricted)
#      Email: <service-account-email>@<project>.iam.gserviceaccount.com
#   5. Paste the entire JSON file content as the value below (single line)
#
# NEVER commit a real key. Add .env to .gitignore (already done).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"nyutaelite-gsc-reader@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
