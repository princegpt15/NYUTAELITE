# .env.example

# Application environment
NODE_ENV=development

# Server port
PORT=5000

# Front-end URL for CORS (production)
FRONTEND_URL=https://nutyaelite.com

# PostgreSQL connection – replace with your credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/nyuta_elite"

# JWT secrets – use long, random strings in production
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"

# Razorpay credentials
RAZORPAY_KEY_ID="replace-with-key-id"
RAZORPAY_KEY_SECRET="replace-with-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
RAZORPAY_ACCOUNT_ID="replace-with-account-id"
RAZORPAY_MERCHANT_ID="replace-with-merchant-id"

# AI service (if used)
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-oss-120b"

# Transactional Email Notifications
# Providers: 'smtp' (GoDaddy Workspace / Office 365) | 'mock' (dev) | 'resend' | 'sendgrid' | 'disabled'
EMAIL_PROVIDER="mock"
EMAIL_ENABLED="false"
EMAIL_TEST_MODE="true"
EMAIL_TEST_RECIPIENT="enterprisesp0r@gmail.com"
EMAIL_FROM="NYUTA ELITE MAKHANA <info@nutyaelite.com>"
EMAIL_FROM_NAME="NYUTA ELITE MAKHANA"
EMAIL_FROM_ADDRESS="info@nutyaelite.com"

# GoDaddy Workspace / Professional SMTP Settings
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@nutyaelite.com"
SMTP_PASS="replace-with-mailbox-password-never-commit"

# Alternative API Providers (optional)
EMAIL_API_KEY=""
EMAIL_API_URL=""

# WhatsApp Transactional Notifications (disabled | meta_cloud | mock)
WHATSAPP_PROVIDER="disabled"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Observability & Monitoring (Phase 14)
ERROR_MONITORING_ENABLED="false"
ERROR_MONITOR_PROVIDER="console"
SLOW_REQUEST_THRESHOLD_MS="1000"

